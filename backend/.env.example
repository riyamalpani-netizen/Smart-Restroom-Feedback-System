DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000

# ── Email alerts (Office 365 SMTP) ──────────────────────────────────────────
# Sends an HTML alert email to ALERT_TO whenever an unhappy/emergency
# complaint is received in a vendor-admin organisation.
#
# SMTP_USER  — the sender address (riya.malpani@atlasied.com)
# SMTP_PASS  — your Office 365 password (or an app password if MFA is on)
# ALERT_TO   — the recipient (anshu.puri@atlasied.com)
#
SMTP_USER=riya.malpani@atlasied.com
SMTP_PASS=Unitedstates@7575
ALERT_TO=anshu.puri@atlasied.com

# ── Microsoft Teams Incoming Webhook ────────────────────────────────────────
# Alerts are posted directly to a Teams channel as an Adaptive Card.
# No Power Automate, no Azure AD, no OAuth required.
#
# How to create the webhook URL (one-time, ~2 min):
#   1. Open the target Teams channel → ··· menu → Connectors
#      (or: ··· → Workflows → search "Incoming Webhook")
#   2. Find "Incoming Webhook" → Configure
#   3. Give it a name (e.g. "Restroom Alerts") → optionally upload an icon
#   4. Click Create → copy the generated https://xxxx.webhook.office.com/... URL
#   5. Paste it below (this is the global fallback; per-org URLs live in Settings)
#
TEAMS_WEBHOOK_URL=https://xxxx.webhook.office.com/webhookb2/your-webhook-url-here

# Public URL of this app — used in the "View Alert in Portal" card button
APP_URL=http://localhost:5173

# The Things Stack device-provisioning API. Use an API key with rights to create end devices.
# When TTN MQTT settings are already configured, the host, application ID, and API key below
# are derived from them. The frequency plan must always be set for the device's radio region.
TTN_API_BASE_URL=https://eu1.cloud.thethings.network
TTN_APPLICATION_ID=your-ttn-application-id
TTN_API_KEY=NNSXS.YOUR_TTN_API_KEY
TTN_GATEWAY_API_KEY=NNSXS.YOUR_GATEWAY_MANAGEMENT_KEY
TTN_GATEWAY_OWNER_TYPE=organization
TTN_GATEWAY_OWNER_ID=your-user-or-organization-id
TTN_FREQUENCY_PLAN_ID=IN_865_867
# Optional: set only when every device uses the same manufacturer-provided JoinEUI.
# TTN_DEFAULT_JOIN_EUI=YOUR_16_HEX_JOIN_EUI
TTN_LORAWAN_VERSION=MAC_V1_0_3
TTN_LORAWAN_PHY_VERSION=PHY_V1_0_3_A

# ── Notification Channel Encryption ─────────────────────────────────────────
# AES-256-GCM key used to encrypt provider secrets (SMTP passwords, API keys, OAuth tokens)
# stored in the notification_channels table. Set this to a long random string.
# If not set, falls back to JWT_SECRET (set this explicitly in production).
NOTIFICATION_ENCRYPTION_KEY=replace-with-a-long-random-secret-32-chars-min

# ── Gmail OAuth2 (for Sign in with Google flow) ──────────────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:5000/api/notifications/gmail/callback
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:5000/api/notifications/gmail/callback
